rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// Regras de segurança do Firebase Storage — Nonato Service.
//
// A regra anterior era "allow read, write: if request.auth != null" para
// o bucket inteiro — qualquer utilizador com sessão Firebase iniciada
// (mesmo sem constar em config/authorizedEmails) podia ler ou escrever
// QUALQUER ficheiro. É a mesma falha corrigida no firestore.rules: a
// lista de emails autorizados nunca era verificada aqui, só no código JS.
//
// Pastas conhecidas (mapeadas a partir do código em src/, grep por
// `ref(storage, ...)`): clientes/, equipamentos/, equipamentosArmazem/,
// config/companyProfile/, documents/, protocolos/, despesas/, users/,
// relatorios/, inspections/, pecas/.
//
// A loja pública (sem sessão) só vê ficheiros do Storage em pecas/: as
// fotografias carregadas ao editar uma peça (services/partEdits.js). Essas
// são servidas pelo URL de download com token guardado em pecasEditadas,
// que não passa por estas regras — daí os limites de tipo e tamanho no
// upload, mais abaixo.
//
// ATENÇÃO: no Storage, quando várias regras "match" apanham o mesmo
// ficheiro, basta UMA permitir para o pedido passar. Por isso as pastas
// com regras mais apertadas (config/companyProfile/, pecas/) têm de ficar
// de fora da regra geral — senão a regra geral anulava as restrições.
//
// ⚠️ Testar com o Firebase Emulator Suite antes de publicar.
// ─────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Espelha a função equivalente em firestore.rules.
    function isAuthorized() {
      return isSignedIn() &&
        request.auth.token.email in
          firestore.get(/databases/(default)/documents/config/authorizedEmails).data.emails;
    }

    function isAdmin() {
      return isAuthorized() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Logo/dados da empresa — leitura para qualquer autorizado, escrita só
    // para admin (o mesmo padrão usado em CompanyProfile.jsx/App.jsx, onde
    // a página "company-profile" já é uma rota admin-only).
    match /config/companyProfile/{allPaths=**} {
      allow read: if isAuthorized();
      allow write: if isAdmin();
    }

    // Resto de config/ — mesmo acesso que a regra geral.
    match /config/{sub}/{allPaths=**} {
      allow read, write: if isAuthorized() && sub != 'companyProfile';
    }

    // Fotografias de peças (services/partEdits.js). Só imagens, até 5 MB.
    // O delete fica à parte porque num delete não existe request.resource.
    match /pecas/{codigo}/{ficheiro} {
      allow read, delete: if isAuthorized();
      allow create, update: if isAuthorized() &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Todo o resto — qualquer utilizador autenticado E autorizado (mesmo
    // nível de acesso que o resto da app usa hoje para as suas coleções).
    match /{pasta}/{allPaths=**} {
      allow read, write: if isAuthorized() &&
        pasta != 'config' && pasta != 'pecas';
    }
  }
}
